# Copy to worker/.env and fill in before starting the worker.
DATABASE_URL=postgresql://osco_app:replace-me@localhost:5432/osco_devhack
REDIS_URL=redis://127.0.0.1:6379

# Relative to worker/. Must be the same directory the backend stores originals in.
DOCUMENT_STORAGE_DIR=../backend/storage/originals

# LLM used for extraction: gemini or groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# Bump to re-extract documents; results are cached per file hash + version in src/cache/.
EXTRACTOR_VERSION=v1

# Queue behaviour (section 8.3)
WORKER_CONCURRENCY=3
RECONCILE_CONCURRENCY=2
JOB_ATTEMPTS=3
JOB_BACKOFF_MS=5000
LLM_RATE_LIMIT_MAX=10
LLM_RATE_LIMIT_WINDOW_MS=60000

# OCR for scans and images: Tesseract must be installed on the machine.
TESSERACT_PATH=tesseract
TESSERACT_LANG=eng

# Resolve dates like 04/05/2021 as dmy or mdy. Leave unset to store both readings and flag them.
# DATE_LOCALE_HINT=dmy
