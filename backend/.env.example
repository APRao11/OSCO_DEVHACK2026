# Copy to backend/.env and replace the placeholder values before starting.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://osco_app:replace-me@localhost:5432/osco_devhack
# Generate a random secret locally, for example: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Original files live on disk; only their storage key and metadata are stored in PostgreSQL.
DOCUMENT_STORAGE_DIR=storage/originals
# Chatbot (RAG answers): gemini or groq, and the matching key. Optional: LLM_MODEL, LLM_FALLBACK_MODELS, LLM_TIMEOUT_MS (per model), LLM_DEADLINE_MS (per question).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
